{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://la-mv-census.local/schemas/mencion.json",
  "title": "Mencion",
  "description": "Unidad atómica de LA MV Census. Sentimiento digital observado, no una encuesta.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "organization_id",
    "study_id",
    "source_kind",
    "text_original",
    "text_clean",
    "language",
    "published_at",
    "collected_at",
    "license_note",
    "is_synthetic",
    "target_ids",
    "classification"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "organization_id": { "type": "string", "format": "uuid" },
    "study_id": { "type": "string", "format": "uuid" },
    "source_kind": {
      "type": "string",
      "enum": ["news", "x", "youtube", "reddit", "facebook", "web_public", "manual_upload"]
    },
    "external_id": { "type": "string" },
    "text_original": { "type": "string", "minLength": 1 },
    "text_clean": { "type": "string" },
    "language": { "type": "string", "default": "es" },
    "published_at": { "type": "string", "format": "date-time" },
    "collected_at": { "type": "string", "format": "date-time" },
    "url": { "type": ["string", "null"] },
    "author_handle": { "type": ["string", "null"] },
    "author_followers": { "type": ["integer", "null"], "minimum": 0 },
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["likes", "replies", "shares", "views"],
      "properties": {
        "likes": { "type": "integer", "minimum": 0 },
        "replies": { "type": "integer", "minimum": 0 },
        "shares": { "type": "integer", "minimum": 0 },
        "views": { "type": "integer", "minimum": 0 }
      }
    },
    "geo_state": { "type": ["string", "null"] },
    "geo_municipality": { "type": ["string", "null"] },
    "theme": { "type": ["string", "null"] },
    "target_ids": {
      "type": "array",
      "items": { "type": "string", "format": "uuid" }
    },
    "relevance_by_target": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sentiment", "stance", "confidence"],
      "properties": {
        "sentiment": { "type": "string", "enum": ["positive", "negative", "neutral"] },
        "stance": {
          "type": "string",
          "enum": ["in_favor", "against", "mixed", "not_applicable"]
        },
        "emotion": { "type": "string" },
        "toxicity": { "type": "number", "minimum": 0, "maximum": 1 },
        "irony": { "type": "number", "minimum": 0, "maximum": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "needs_review": { "type": "boolean" },
        "model_name": { "type": "string" }
      }
    },
    "raw_payload_id": { "type": ["string", "null"] },
    "license_note": { "type": "string", "minLength": 1 },
    "normalized_hash": { "type": "string" },
    "is_synthetic": { "type": "boolean" }
  }
}
